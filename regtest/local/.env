# Fixed keys for a regtest environment on your own machine. Never reuse them on
# a network where coins have value.

# The data-sync service the environment runs, as a commit of
# github.com/breez/data-sync. nix/packages.nix reads the pin from here.
DATA_SYNC_VERSION=adaa7b1df8bd37a9a34efe09373ff7fa81c4668e

BITCOIND_RPC_USER=rpcuser
BITCOIND_RPC_PASSWORD=rpcpassword

# The operators' identity keys are 0101..01, 0202..02 and 0303..03.
OPERATOR_IDENTITY_PUBLIC_KEYS="031b84c5567b126440995d3ed5aaba0565d71e1834604819ff9c17f5e9d5dd078f 024d4b6cd1361032ca9bd2aeb9d900aa4d45d9ead80ac9423374c451a7254d0766 02531fe6068134503d2723133227c867ac8fa6c83c537e9a44c3c5bdbdcb1fe337"

SSP_WALLET_SEED=0505050505050505050505050505050505050505050505050505050505050505
SSP_IDENTITY_PUBLIC_KEY=03e7343c4fdcffdce7b0041c4f482948a1058f8fe8d5a48e0a0c4e884d0e7cc124

# The SSP re-signs invoices as its Lightning node, so it holds the node key that
# ldk-server derives from this mnemonic. Alice is the second Lightning node,
# which the SSP's node holds a channel with, so a payment can leave and enter
# the environment.
LDK_SERVER_MNEMONIC="senior cement alpha earth river hero similar leg broken symptom under word suggest great permit pulse tool cart describe execute lounge sibling pave resemble"
LDK_SERVER_NODE_SECRET_KEY=7bbe27e39e948222a53a24aba8360673802a308a6374e232c5cf1a525312859a
LDK_SERVER_API_KEY=3b3665164439cc5c328d9171cfbdc3af29e3c41c96df28364756f47c3752f51d

# The lnurl server's Spark identity, which it authenticates to the SSP with.
LNURL_AUTH_SEED=0606060606060606060606060606060606060606060606060606060606060606

ALICE_MNEMONIC="acquire deliver forum shadow approve small rigid history change own scorpion dish dumb offer lonely omit donor cotton kite thunder silent build chair solar"
ALICE_API_KEY=d0b6651a0515f985fe3c11737a783d756bbc6f74b2167506b6d495ad3f52695d
