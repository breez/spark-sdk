{
    "name": "@breeztech/breez-sdk-spark",
    "version": "0.1.0",
    "description": "Breez Spark SDK",
    "repository": "https://github.com/breez/spark-sdk",
    "author": "Breez <contact@breez.technology> (https://github.com/breez)",
    "homepage": "https://breez.technology",
    "license": "MIT",
    "bugs": {
      "url": "https://github.com/breez/spark-sdk/issues"
    },
    "files": [
      "bundler",
      "deno",
      "nodejs",
      "web",
      "ssr"
    ],
    "types": "./nodejs/index.d.ts",
    "exports": {
      "./bundler": "./bundler/index.js",
      "./deno": "./deno/breez_sdk_spark_wasm.js",
      "./nodejs": {
        "import": {
          "types": "./nodejs/index.d.mts",
          "default": "./nodejs/index.mjs"
        },
        "require": {
          "types": "./nodejs/index.d.ts",
          "default": "./nodejs/index.js"
        },
        "default": "./nodejs/index.js"
      },
      "./web": "./web/index.js",
      "./ssr": "./ssr/index.js",
      "./passkey-prf-provider": {
        "types": "./web/passkey-prf-provider/index.d.ts",
        "import": "./web/passkey-prf-provider/index.js",
        "default": "./web/passkey-prf-provider/index.js"
      },
      ".": {
        "node": {
          "import": {
            "types": "./nodejs/index.d.mts",
            "default": "./nodejs/index.mjs"
          },
          "require": {
            "types": "./nodejs/index.d.ts",
            "default": "./nodejs/index.js"
          },
          "default": "./nodejs/index.js"
        },
        "deno": "./deno/breez_sdk_spark_wasm.js",
        "default": "./web/index.js"
      }
    },
    "publishConfig": {
      "registry": "https://registry.npmjs.org/"
    },
    "engines": {
      "node": ">=22"
    },
    "optionalDependencies": {
      "better-sqlite3": "^12.2.0",
      "pg": "^8.18.0"
    }
  }