export CARGO_TERM_COLOR := "always"

repo_root := justfile_directory() / ".." / ".."
mobile_features := "db-storage-api,secp-lowmemory,release-max-level-debug"

# Lists available recipes
default:
  just --list --unsorted

# Initializes the workspace (run this first)
setup: install-bindgen
	flutter pub get
	just check-deps
	@echo "🎉 Setup complete! You can now run 'just codegen' to generate the bindings."

# Installs the uniffi-dart binding generator (UNIFFI_DART_GIT=file://... for a local checkout)
install-bindgen:
	make -C {{repo_root}}/crates/breez-sdk/bindings install-uniffi-bindgen-dart

# Check system dependencies
check-deps:
	#!/usr/bin/env bash
	set -euo pipefail

	echo "🔍 Checking system dependencies..."

	# Check Rust
	if command -v cargo &> /dev/null; then
		echo "✅ $(cargo --version)"
	else
		echo "❌ cargo not found. Please install Rust."
		MISSING=1
	fi

	# Check Flutter
	if command -v flutter &> /dev/null; then
		echo "✅ $(flutter --version | head -n1)"
	else
		echo "❌ flutter not found. Please install Flutter."
		MISSING=1
	fi

	# Check the binding generator
	if command -v uniffi_bindgen_dart &> /dev/null; then
		echo "✅ $(uniffi_bindgen_dart --version)"
	else
		echo "❌ uniffi_bindgen_dart not found. Run 'just install-bindgen'."
		MISSING=1
	fi

	if [ "${MISSING:-0}" -eq 1 ]; then
		echo "Please install the missing dependencies and try again."
		exit 1
	else
		echo "🎉 All dependencies are installed."
	fi

# Builds the bindings library for this host. The generator reads its metadata.
build-host:
	cd {{repo_root}} && cargo build -p breez-sdk-spark-bindings --no-default-features --features {{mobile_features}}

# Generates the Dart bindings and the callback relay crate
codegen: build-host
	#!/usr/bin/env bash
	set -euo pipefail
	root="{{repo_root}}"
	out="$root/target/dart-gen"
	ext=$([ "$(uname)" = Darwin ] && echo dylib || echo so)
	rm -rf "$out"
	(cd "$root" && uniffi_bindgen_dart --library "target/debug/libbreez_sdk_spark_bindings.$ext" \
		--crate breez_sdk_spark --out-dir "$out")
	rm -rf lib/src/generated native/dispatch
	mkdir -p lib/src/generated native
	mv "$out"/*.dart lib/src/generated/
	mv "$out/uniffi_dispatch" native/dispatch

# Runs the package tests. The build hook builds the native libraries for this host.
test: codegen
	flutter test

# Update version number on pubspec.yaml, podspec & Gradle script
version:
	bash scripts/version.sh

# Clean all build artifacts
clean:
	flutter clean
	rm -rf lib/src/generated native/dispatch
